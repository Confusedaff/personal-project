# Fake News Detection — Environment Variables
# Copy this file to .env and fill in real values.

# ── Required ──────────────────────────────────────────────────────────
# JWT secret key — MUST be changed in production (use a long random string)
SECRET_KEY=dev-secret-change-in-production-please

# Token expiry in minutes (default: 1440 = 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# ── Optional: LLM / Search API keys ──────────────────────────────────
# System degrades gracefully without these — rule-based fallbacks are used.

# Groq API key (primary LLM for fact-checking and claim extraction)
GROQ_API_KEY=

# Anthropic API key (fallback LLM provider)
ANTHROPIC_API_KEY=

# OpenAI API key (used for claim extraction if OPENAI_BASE_URL is set)
OPENAI_API_KEY=

# Google Fact Check Tools API key
FACTCHECK_API_KEY=

# Brave Search API key (fallback web search)
BRAVE_API_KEY=

# ── Optional: LLM model configuration ────────────────────────────────
# GROQ_MODEL=openai/gpt-oss-120b
# CLAIM_EXTRACTION_MODEL=gpt-4o-mini
# FACTCHECK_LLM_MODEL=claude-sonnet-4-6
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Optional: CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins. Default: * (allow all).
# For production, set to your frontend domain(s).
# CORS_ORIGINS=https://your-domain.com
