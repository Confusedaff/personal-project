# Fake News Detection — Environment Variables
# Copy this file to .env and fill in real values.

# JWT secret key (CHANGE THIS IN PRODUCTION)
SECRET_KEY=dev-secret-change-in-production-please

# Token expiry in minutes (default: 1440 = 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# API keys for live verification (optional — system degrades gracefully without them)
# FACTCHECK_API_KEY=your-google-fact-check-api-key
# OPENAI_API_KEY=your-openai-api-key
# GROQ_API_KEY=your-groq-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# TAVILY_API_KEY=your-tavily-api-key
